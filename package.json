{
  "name": "temp-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "corepack pnpm --filter @aavil/backend dev",
    "dev:all": "concurrently -k -n web,api -c cyan,green \"vite\" \"corepack pnpm --filter @aavil/backend dev\"",
    "build": "tsc -b && corepack pnpm --filter @aavil/backend build && vite build",
    "db:generate": "corepack pnpm --filter @aavil/backend db:generate",
    "db:migrate": "corepack pnpm --filter @aavil/backend db:migrate",
    "db:seed": "corepack pnpm --filter @aavil/backend db:seed",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@e965/xlsx": "^0.20.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
